"rules.title" = "Rules";
"rules.turnOrder.title" = "Turn Order";
"rules.turnOrder.body" = "Play passes around the table. On your turn, match the top card of the discard pile by color, number or symbol, or draw a card if you can't play.";
"rules.specialCards.title" = "Special Cards";
"rules.specialCards.body" = "Skip passes the turn. Reverse changes the direction of play. Draw Two forces the next player to draw two cards. Wild lets you choose the color. Wild Draw Four also forces the next player to draw four cards.";
"rules.unoCall.title" = "Calling UNO";
"rules.unoCall.body" = "When you are down to one card, tap the UNO button before your turn ends. If another player catches you first, you must draw two penalty cards.";
"rules.scoring.title" = "Scoring";
"rules.scoring.body" = "The first player to play all their cards wins the round and scores points based on the cards left in opponents' hands. The first player to reach 500 points wins the game.";

