"rules.turnOrder.title" = "Ordem de Jogo";
"rules.turnOrder.body" = "A vez passa à volta da mesa. Na tua vez, junta a carta do topo da pilha de descarte por cor, número ou símbolo, ou compra uma carta se não puderes jogar.";
"rules.specialCards.title" = "Cartas Especiais";
"rules.specialCards.body" = "Saltar passa a vez. Inverter muda o sentido do jogo. Compra Duas obriga o jogador seguinte a comprar duas cartas. Curinga permite escolher a cor. Curinga Compra Quatro também obriga o jogador seguinte a comprar quatro cartas.";
"rules.unoCall.title" = "Dizer UNO";
"rules.unoCall.body" = "Quando ficares com uma carta, toca em UNO antes de o jogador seguinte agir. Se alguém te apanhar primeiro, compras duas cartas de penalização. A IA também te pode apanhar.";
"rules.scoring.title" = "Pontuação";
"rules.scoring.body" = "O primeiro jogador a jogar todas as suas cartas ganha a ronda e soma pontos com base nas cartas que restam aos adversários. O primeiro a atingir 500 pontos vence o jogo.";

